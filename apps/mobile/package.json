{
  "name": "@milagre/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "postinstall": "cd ../.. && patch-package --patch-dir apps/mobile/patches",
    "eas-build-post-install": "npm run postinstall",
    "start": "node ../../scripts/start-mobile.cjs",
    "android": "node ../../scripts/start-mobile.cjs --android",
    "ios": "node ../../scripts/start-mobile.cjs --ios",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/*.test.ts",
    "export:ios": "expo export --platform ios",
    "update:testflight": "npx eas-cli@latest update --channel testflight --environment production --platform all --non-interactive"
  },
  "dependencies": {
    "@expo/ui": "~58.0.20",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react-native": "^1.0.16",
    "@milagre/shared": "0.1.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@sbaiahmed1/react-native-blur": "6.0.2",
    "expo": "~58.0.13",
    "expo-audio": "~58.0.9",
    "expo-build-properties": "~58.0.10",
    "expo-camera": "~58.0.10",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.9",
    "expo-font": "~58.0.8",
    "expo-haptics": "~58.0.7",
    "expo-image-manipulator": "~58.0.14",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-modules-core": "~58.0.21",
    "expo-network": "~58.0.3",
    "expo-notifications": "~58.1.5",
    "expo-router": "~58.0.22",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-updates": "~58.0.17",
    "markdown-it": "^15.0.2",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  }
}
