{
  "expo": {
    "name": "Milagre",
    "slug": "milagre",
    "scheme": ["milagre", "milagre-local"],
    "version": "0.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true
          },
          "android": {
            "usesCleartextTraffic": true,
            "extraProguardRules": "-keepnames class com.swmansion.rnscreens.Screen\n-keepnames class com.facebook.react.ReactRootView"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-mark.png",
          "imageWidth": 64,
          "resizeMode": "contain",
          "backgroundColor": "#fafafb",
          "dark": {
            "image": "./assets/splash-mark-dark.png",
            "backgroundColor": "#17181a"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Milagre uses the camera to scan your Mac's pairing code and to take photos for a Chat.",
          "microphonePermission": "Milagre uses the microphone when you dictate a message. Your voice is turned into text on this device.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Milagre attaches the photos you pick to a Chat.",
          "cameraPermission": "Milagre uses the camera to scan your Mac's pairing code and to take photos for a Chat.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "chats",
          "sounds": [
            "./assets/sounds/chime_miracle.wav",
            "./assets/sounds/chime_faaah.wav",
            "./assets/sounds/chime_bombastic_side_eye.wav",
            "./assets/sounds/chime_vine_boom.wav",
            "./assets/sounds/chime_metal_pipe.wav",
            "./assets/sounds/chime_bruh.wav",
            "./assets/sounds/chime_emotional_damage.wav"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Milagre uses the microphone when you dictate a message. Your voice is turned into text on this device.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "./plugins/with-live-activity.cjs",
      "expo-font",
      "expo-status-bar"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.victorlucas.milagre",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "Milagre connects to your computer directly when you are on the same network.",
        "NSSpeechRecognitionUsageDescription": "Milagre turns your dictated message into text on this device. Your voice never leaves it."
      }
    },
    "android": {
      "package": "com.victorlucas.milagre",
      "permissions": ["android.permission.CAMERA"]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "53a87eea-769e-4d7c-a818-b9e2440cc065"
      }
    },
    "owner": "victorlucss",
    "updates": {
      "url": "https://u.expo.dev/53a87eea-769e-4d7c-a818-b9e2440cc065"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
