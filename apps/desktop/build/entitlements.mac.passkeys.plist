<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- The main app's entitlements in a release signed with the provisioning profile (build-macos.yml):
         entitlements.mac.plist plus the keychain group Touch ID passkeys are stored under (passkeys.cjs). -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.application-identifier</key>
    <string>YWMU5N9D6K.com.milagre.app</string>
    <key>com.apple.developer.team-identifier</key>
    <string>YWMU5N9D6K</string>
    <key>keychain-access-groups</key>
    <array>
      <string>YWMU5N9D6K.com.milagre.app.webauthn</string>
    </array>
  </dict>
</plist>
