{
  "name": "milagre",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first desktop ADE for coordinating coding agents",
  "homepage": "https://github.com/the-ptf/milagre-ade",
  "license": "MIT",
  "author": "Milagre contributors",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5180\" \"wait-on http://127.0.0.1:5180 && MILAGRE_DEV_SERVER_URL=http://127.0.0.1:5180 node ../../scripts/launch-electron.cjs\"",
    "start": "node ../../scripts/launch-electron.cjs",
    "build": "npm run typecheck && vite build",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json",
    "test:agent": "node --test electron/*.test.cjs",
    "test:ui": "node --test \"app/src/**/*.test.ts\""
  },
  "dependencies": {
    "@fugood/whisper.node": "1.1.3",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@milagre/core": "0.1.0",
    "@milagre/daemon": "0.1.0",
    "@milagre/shared": "0.1.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "^12.12.0",
    "electron-updater": "^6.8.9",
    "motion": "^13.5.1",
    "pele": "1.6.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "electron": "^44.5.1",
    "postcss": "^8.5.28",
    "shadow-plugin": "^2.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^7.1.7",
    "wait-on": "^8.0.4"
  },
  "desktopName": "milagre.desktop",
  "productName": "Milagre"
}
