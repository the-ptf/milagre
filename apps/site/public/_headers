# Built assets have content hashes in their names; the recordings and posters change only with a new take.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/demo/*
  Cache-Control: public, max-age=2592000
/icons.svg
  Cache-Control: public, max-age=2592000
/logos/*
  Cache-Control: public, max-age=2592000
# Points agents at the machine-readable versions of the site (RFC 8288).
/
  Link: </llms.txt>; rel="describedby"; type="text/plain", </index.md>; rel="alternate"; type="text/markdown", </.well-known/agent-skills/index.json>; rel="describedby"; type="application/json", </.well-known/ai-catalog.json>; rel="describedby"; type="application/json"
/.well-known/*
  Access-Control-Allow-Origin: *
