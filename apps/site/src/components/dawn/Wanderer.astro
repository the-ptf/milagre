---
// The landed star, travelling with the reader: once the hero scrolls away it crosses the window from left to right, tied
// to the scroll position (a CSS scroll timeline, so it moves exactly as fast as the page). Styles in styles/dawn.css.
import { MARK_STAR } from "../../dawn";
---
<div class="dawn-wanderer" aria-hidden="true">
  <span class="dawn-wanderer-tail"></span>
  <svg viewBox="26 -1 94 94"><path d={MARK_STAR} /></svg>
</div>
