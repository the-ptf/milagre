---
// The landed star, travelling with the reader down the page: it winds behind the app windows, lighting their edges,
// leaves a trail of star dust and lands on the footer's logo, whose legs rise under it. Its position follows the scroll through
// a scroll timeline (no scroll listener); this script redraws the path and its animations when the page changes size. Styles in styles/dawn.css.
import { MARK_STAR } from "../../dawn";
---
<div class="dawn-trail" aria-hidden="true" data-trail>
  <svg class="dawn-trail-svg">
    <mask id="dawn-trail-window" maskUnits="userSpaceOnUse"><path class="dawn-trail-path dawn-trail-window" data-tail="620" /></mask>
    <path class="dawn-trail-path dawn-trail-glow" data-tail="520" />
    <path class="dawn-trail-path dawn-trail-dust" mask="url(#dawn-trail-window)" />
    <path class="dawn-trail-path dawn-trail-core" data-tail="180" />
  </svg>
  <div class="dawn-traveller">
    <div class="dawn-traveller-body">
      <span class="dawn-traveller-light"></span>
      <svg viewBox="26 -1 94 94"><path d={MARK_STAR} /></svg>
    </div>
  </div>
</div>

<script>
  const trail = document.querySelector<HTMLElement>("[data-trail]");
  const story = trail?.parentElement;
  const brand = story?.querySelector<SVGSVGElement>(".footer-mark");
  const svg = trail?.querySelector("svg");
  const traveller = trail?.querySelector<HTMLElement>(".dawn-traveller");
  const body = traveller?.firstElementChild;
  const moving = typeof ScrollTimeline === "function" && !matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (moving && trail && story && brand && svg && traveller && body) {
    // From the top of the first section below the hero.
    const TOP = 40;
    const draw = () => {
      const box = story.getBoundingClientRect();
      const mark = brand.getBoundingClientRect();
      const width = story.clientWidth;
      // It comes to rest on the footer logo's sparkle (half across, 32.5% down), at the sparkle's size.
      const endX = mark.left - box.left + mark.width / 2;
      const endY = mark.top - box.top + mark.height * 0.325 - TOP;
      const height = Math.ceil(endY + 40);
      trail.style.top = `${TOP}px`;
      trail.style.height = `${height}px`;
      // Swings out to the right and back to the left about once a screen, starting the way the sketch did: right
      // behind the Designs panel, left behind the canvas. One smooth curve runs through the swings (a Catmull-Rom
      // spline drawn as cubic Béziers), so it never turns a corner.
      const swings = Math.max(2, Math.round((endY - 260) / 900));
      const step = (endY - 260) / swings;
      const points: [number, number][] = [[-0.02 * width, 0.02 * height]];
      for (let index = 1; index <= swings; index++) points.push([(index % 2 ? 0.93 : 0.07) * width, index * step]);
      points.push([endX, endY]);
      const p = ([x, y]: [number, number]) => `${x.toFixed(1)},${y.toFixed(1)}`;
      // Above 1 the curve swings wider round each turn.
      const SWIRL = 1.5;
      let d = `M${p(points[0]!)}`;
      for (let index = 0; index < points.length - 1; index++) {
        const [a, b, c, e] = [points[index - 1] ?? points[index]!, points[index]!, points[index + 1]!, points[index + 2] ?? points[index + 1]!];
        const c1: [number, number] = [b[0] + ((c[0] - a[0]) / 6) * SWIRL, b[1] + ((c[1] - a[1]) / 6) * SWIRL];
        const c2: [number, number] = [c[0] - ((e[0] - b[0]) / 6) * SWIRL, c[1] - ((e[1] - b[1]) / 6) * SWIRL];
        d += ` C${p(c1)} ${p(c2)} ${p(c)}`;
      }
      svg.setAttribute("viewBox", `0 0 ${width} ${height}`);
      for (const path of svg.querySelectorAll("path")) path.setAttribute("d", d);
      const length = svg.querySelector<SVGPathElement>(".dawn-trail-core")?.getTotalLength() ?? 0;
      trail.style.setProperty("--len", `${Math.ceil(length)}px`);
      traveller.style.offsetPath = `path("${d}")`;
      // The star starts moving when the trail's top reaches the middle of the window and arrives as the page ends.
      // Animations are made afresh here: CSS keyframes keep the path length they first saw.
      const start = Math.max(0, Math.round(box.top + scrollY + TOP - innerHeight / 2));
      const rest = (mark.width * 0.61) / traveller.offsetWidth;
      const timing = { timeline: new ScrollTimeline({ source: document.documentElement }), rangeStart: `${start}px`, rangeEnd: "100%", fill: "both" } as KeyframeAnimationOptions;
      for (const animation of running) animation.cancel();
      running = [
        // Lands a little before the page ends, so the legs rise under it.
        traveller.animate(
          [
            { offsetDistance: "0px", opacity: 0 },
            { opacity: 1, offset: 0.04 },
            { offsetDistance: `${length}px`, opacity: 1, offset: 0.94 },
            { offsetDistance: `${length}px`, opacity: 1 },
          ],
          timing,
        ),
        // Shrinks to the logo's sparkle as it lands (on an inner box: Chrome misplaces a scaled element on a path).
        body.animate([{ scale: 1, offset: 0.9 }, { scale: rest, offset: 0.94 }, { scale: rest }], timing),
        // Each stroke shows only the stretch of path just behind the star.
        ...[...svg.querySelectorAll<SVGPathElement>("[data-tail]")].map((path) => {
          const tail = Number(path.dataset.tail);
          return path.animate([{ strokeDashoffset: `${tail}px` }, { strokeDashoffset: `${tail - length}px` }], timing);
        }),
      ];
    };
    let running: Animation[] = [];
    new ResizeObserver(draw).observe(story);
    addEventListener("resize", draw);
  }
</script>
