---
import { REPO_URL } from "../links";
---
<header class="nav container">
  <a class="brand" href="/" aria-label="Milagre home">
    <img src="/app-icon-64.webp" alt="" width="30" height="30" />
    <span>Milagre</span>
  </a>
  <nav aria-label="Help" class="help"><a href="/privacy">Privacy</a><a href="/support">Support</a></nav>
  <a class="stars" href={REPO_URL}>
    <svg aria-hidden="true" width="16" height="16"><use href="/icons.svg#github" /></svg>
    <span>Star<span class="visually-hidden"> Milagre on GitHub</span></span>
    <span class="count" data-stars hidden></span>
  </a>
</header>

<script>
  // The Worker serves /api/stars; without it (or if GitHub is down) the pill stays a plain "Star" link.
  const count = document.querySelector<HTMLElement>("[data-stars]");
  fetch("/api/stars")
    .then(response => (response.ok ? response.json() : null))
    .then(data => {
      if (!count || !Number.isInteger(data?.stars)) return;
      count.textContent = new Intl.NumberFormat("en", { notation: "compact", maximumFractionDigits: 1 }).format(data.stars);
      count.hidden = false;
    })
    .catch(() => {});
</script>

<style>
  .nav { display: flex; flex-shrink: 0; align-items: center; justify-content: space-between; height: 72px; }
  .help { display: flex; gap: 16px; margin-left: auto; margin-right: 20px; font-size: 14px; }
  .help a { color: var(--ink-2); text-decoration: none; text-underline-offset: 4px; }
  .help a:hover { color: var(--ink); text-decoration: underline; }
  @media (max-width: 420px) { .help { gap: 12px; margin-right: 12px; } .brand span { display: none; } }
  .brand { display: flex; align-items: center; gap: 10px; font-weight: 650; font-size: 18px; text-decoration: none; }
  .brand img { border-radius: 7px; }
  .stars { display: inline-flex; align-items: center; gap: 8px; height: 34px; padding: 0 12px; border-radius: var(--radius-control); background: var(--surface); box-shadow: var(--shadow-btn); color: var(--ink); font-size: 14px; font-weight: 600; text-decoration: none; transition: background-color 120ms var(--ease-out-strong); }
  .stars:hover { background: var(--hover); }
  .count { padding-left: 8px; border-left: 1px solid var(--line-strong); color: var(--ink-2); font-variant-numeric: tabular-nums; }
  .count[hidden] { display: none; }
</style>
