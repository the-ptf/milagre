---
---
<p class="demo-description">
  Video: Milagre on a Mac and a phone showing the same Chat. The agent asks to run the mobile checks, the request is approved on the phone, and the agent finishes on the Mac.
</p>
<div class="demo" aria-hidden="true" data-demo>
  <div class="mac">
    <video class="mac-video" src="/demo/desktop.mp4" muted playsinline preload="none" data-desktop></video>
    <div class="lights"><i></i><i></i><i></i></div>
  </div>
  <div class="phone">
    <video class="phone-video" poster="/demo/phone.webp" muted playsinline preload="none" data-phone></video>
  </div>
</div>
<script is:inline>
  (() => {
    const demo = document.currentScript.previousElementSibling;
    const take = document.documentElement.dataset.platform === "android" ? "android" : "phone";
    const phone = demo.querySelector("[data-phone]");
    if (take !== "phone") phone.poster = `/demo/${take}.webp`;
    phone.src = `/demo/${take}.mp4`;
    if (!matchMedia("(max-width: 700px)").matches) {
      const desktop = demo.querySelector("[data-desktop]");
      desktop.poster = "/demo/desktop.webp";
    }
  })();
</script>

<script>
  const demo = document.querySelector<HTMLElement>("[data-demo]");
  const stage = demo?.parentElement;
  const desktop = demo?.querySelector<HTMLVideoElement>("[data-desktop]");
  const phone = demo?.querySelector<HTMLVideoElement>("[data-phone]");

  if (demo && stage && desktop && phone) {
    if (document.documentElement.dataset.platform === "android") demo.classList.add("android");
    const narrow = matchMedia("(max-width: 700px)");
    const cta = document.querySelector<HTMLElement>("[data-cta]");
    const page = stage.closest<HTMLElement>(".page");
    let spare = 0;
    const fit = () => {
      const drop = spare / 2;
      // Measure within the hero (offsetTop ignores Dawn's rise and the scroll), so neither changes its size.
      const stageTop = stage.offsetTop;
      const room = (page?.clientHeight ?? innerHeight) - stageTop - (cta?.offsetHeight ?? 0) - drop - 12;
      const scale = Math.max(Math.min(1.7, stage.clientWidth / demo.offsetWidth, room / 565), 0.1);
      demo.style.setProperty("--scale", String(scale));
      const next = Math.max(0, Math.round(spare + room - 565 * scale));
      if (Math.abs(next - spare) > 1) {
        spare = next;
        page?.style.setProperty("--lift", `${Math.floor(spare / 2)}px`);
        page?.style.setProperty("--drop", `${Math.ceil(spare / 2)}px`);
      }
    };
    new ResizeObserver(fit).observe(stage);
    narrow.addEventListener("change", fit);
    fit();

    const still = matchMedia("(prefers-reduced-motion: reduce)");
    const clock = () => (narrow.matches ? phone : desktop);
    const follower = () => (narrow.matches ? null : phone);

    for (const video of [desktop, phone]) {
      const markReady = () => {
        if (video.readyState >= 2) video.dataset.ready = "";
      };
      video.addEventListener("loadeddata", markReady);
      video.addEventListener("playing", markReady);
      markReady();
    }

    const play = () => {
      if (still.matches) return;
      for (const video of narrow.matches ? [phone] : [desktop, phone]) {
        if (video.preload === "none") video.preload = "auto";
        void video.play().catch(() => {});
      }
    };
    const restart = () => {
      for (const video of [desktop, phone]) video.currentTime = 0;
      play();
    };
    for (const video of [desktop, phone]) {
      video.addEventListener("timeupdate", () => {
        if (video !== clock()) return;
        const other = follower();
        if (other && Math.abs(other.currentTime - video.currentTime) > 0.12) other.currentTime = video.currentTime;
      });
      video.addEventListener("ended", () => {
        if (video === clock()) restart();
      });
    }
    const visible = new IntersectionObserver(([entry]) => {
      if (entry?.isIntersecting) play();
      else for (const video of [desktop, phone]) video.pause();
    });
    visible.observe(demo);
    narrow.addEventListener("change", () => {
      if (!narrow.matches && !desktop.poster) desktop.poster = "/demo/desktop.webp";
      desktop.pause();
      restart();
    });
  }
</script>

<style>
  .demo-description { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .demo { position: absolute; top: 0; left: 50%; width: 1220px; height: 700px; transform: translateX(-50%) scale(var(--scale, 1)); transform-origin: top center; }
  .mac { position: absolute; top: 0; left: 0; width: 1000px; aspect-ratio: 16 / 10; overflow: hidden; border-radius: 14px; background: oklch(0.2 0.03 258); box-shadow: var(--shadow-window); }
  .mac-video, .phone-video { display: block; width: 100%; height: 100%; object-fit: cover; background-size: cover; background-position: center; background-repeat: no-repeat; }
  .mac-video[poster] { background-image: url("/demo/desktop.webp"); }
  .phone-video { border-radius: 41px; background-image: url("/demo/phone.webp"); }
  .phone::after { content: ""; position: absolute; inset: 11px; border-radius: 41px; background: url("/demo/phone.webp") center / cover no-repeat; pointer-events: none; }
  .phone:has([data-ready])::after, .mac:has([data-ready])::after { display: none; }
  @media (min-width: 701px) {
    .mac::after { content: ""; position: absolute; inset: 0; background: url("/demo/desktop.webp") center / cover no-repeat; pointer-events: none; }
  }
  .lights { --k: calc(1000 / 1280); position: absolute; top: calc((22 - 6) * var(--k) * 1px); left: calc(24 * var(--k) * 1px); z-index: 1; display: flex; gap: calc(8 * var(--k) * 1px); }
  .lights i { width: calc(12 * var(--k) * 1px); height: calc(12 * var(--k) * 1px); border-radius: 50%; background: #ff5f57; }
  .lights i:nth-child(2) { background: #febc2e; }
  .lights i:nth-child(3) { background: #28c840; }
  .phone { position: absolute; right: 0; bottom: 0; width: 290px; aspect-ratio: 1206 / 2622; box-sizing: content-box; padding: 11px; border-radius: 52px; background: #0b0b0c; box-shadow: inset 0 0 0 1.5px oklch(1 0 0 / 0.16), 0 0 0 1px oklch(0 0 0 / 0.5), 0 30px 70px rgb(40 30 70 / 0.35); }
  .demo.android .phone, :global(html[data-platform="android"]) .demo .phone { aspect-ratio: 1080 / 2424; border-radius: 28px; }
  .demo.android .phone-video, :global(html[data-platform="android"]) .demo .phone-video, .demo.android .phone::after, :global(html[data-platform="android"]) .demo .phone::after { border-radius: 17px; background-image: url("/demo/android.webp"); }

  @media (max-width: 700px) {
    .demo { width: 312px; height: 678px; }
    .mac { display: none; }
  }
</style>
