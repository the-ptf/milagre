---
// DESIGN.md's contrast floors measured on the default theme: each text token on its worst ground, light and dark.
import { contrastChecks, SCHEMES } from "../../design-system";

const checks = SCHEMES.map((scheme) => contrastChecks(scheme));
const rows = checks[0].map((check, index) => ({ check, dark: checks[1][index] }));
---
<div class="table-wrap">
  <table>
    <thead>
      <tr><th scope="col">Text</th><th scope="col">On</th><th scope="col">Floor</th><th scope="col">Light</th><th scope="col">Dark</th></tr>
    </thead>
    <tbody>
      {
        rows.map(({ check, dark }) => (
          <tr>
            <td><code>{check.text}</code></td>
            <td>{check.ground}</td>
            <td class="num">{check.floor}:1</td>
            {[check, dark].map((measured) => (
              <td>
                <span class="sample" style={`color:${measured.color};background:${measured.background}`}>Aa</span>
                <span class="num">{measured.ratio.toFixed(2)}</span>
              </td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .table-wrap { margin-top: 20px; overflow-x: auto; border-radius: 12px; background: var(--canvas); box-shadow: var(--shadow-card); }
  table { width: 100%; border-collapse: collapse; font-size: 14px; }
  th { padding: 10px 14px; color: var(--ink-3); font-size: 13px; font-weight: 500; text-align: left; white-space: nowrap; }
  td { padding: 8px 14px; border-top: 1px solid var(--line); color: var(--ink-2); white-space: nowrap; }
  td code { color: var(--ink); font-size: 13px; }
  .num { font-variant-numeric: tabular-nums; }
  .sample { display: inline-grid; place-items: center; width: 34px; height: 26px; margin-right: 8px; border-radius: 6px; box-shadow: inset 0 0 0 1px rgb(42 33 22 / 0.12); font: 600 13px ui-sans-serif, system-ui, -apple-system, sans-serif; vertical-align: middle; }
</style>
