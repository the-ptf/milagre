---
import { Add01Icon } from "@hugeicons/core-free-icons";
import { icon } from "../hugeicon";
import { REPO_URL } from "../links";

const agents = [
  { provider: "claude", name: "Claude Code", company: "Anthropic" },
  { provider: "codex", name: "Codex", company: "OpenAI" },
  { provider: "antigravity", name: "Antigravity", company: "Google" },
  { provider: "kiro", name: "Kiro", company: "AWS" },
];
---

<section class="byos container below-fold" id="bring-your-subscription" aria-labelledby="byos-title">
  <h2 id="byos-title">Bring your own subscription. <em>Keep the plan you have.</em></h2>
  <ul class="agents" aria-label="Supported coding agents">
    {agents.map(agent => (
      <li>
        <img src={`/logos/${agent.provider}.svg`} alt="" width="44" height="44" loading="lazy" />
        <div class="agent-name"><h3>{agent.name}</h3><p>{agent.company}</p></div>
      </li>
    ))}
    <li>
      {/* Milagre is open source: the next agent can come from anyone. */}
      <a class="add" href={`${REPO_URL}/pulls`}>
        <span class="add-mark" set:html={icon(Add01Icon, 20)} />
        <div class="agent-name"><h3>Yours next</h3><p>Open source: send a PR</p></div>
      </a>
    </li>
  </ul>
  <p class="note">Milagre is free and open source. Your provider's subscription or usage charges still apply.</p>
</section>

<style>
  .byos { padding-block: clamp(40px, 5vw, 72px) clamp(72px, 9vw, 120px); text-align: center; }
  h2 { font-size: clamp(34px, 4.4vw, 54px); font-weight: 600; letter-spacing: -0.035em; text-wrap: balance; }
  h2 em { display: block; font-family: var(--font-serif); font-size: 1.12em; font-weight: 400; letter-spacing: -0.01em; color: oklch(0.86 0.06 255); }
  .agents { display: grid; grid-template-columns: repeat(5, 1fr); max-width: 960px; margin: 56px auto 32px; padding: 0; list-style: none; }
  li { display: flex; flex-direction: column; align-items: center; gap: 14px; padding: 8px 16px; }
  img { flex-shrink: 0; }
  .add { display: flex; flex-direction: column; align-items: center; gap: 14px; color: inherit; text-decoration: none; }
  .add-mark { display: grid; width: 44px; height: 44px; place-items: center; border: 1.5px dashed var(--line-strong); border-radius: 12px; color: var(--ink-2); transition: border-color 150ms, color 150ms, transform 150ms var(--ease-out-strong); }
  .add:hover .add-mark { border-color: var(--accent); color: var(--accent-ink); transform: rotate(90deg); }
  .add:hover h3 { text-decoration: underline; text-underline-offset: 4px; }
  h3 { font-size: 17px; font-weight: 500; letter-spacing: -0.01em; }
  li p { margin-top: 4px; color: var(--ink-3); font-size: 13px; }
  .note { color: var(--ink-3); font-size: 14px; line-height: 1.6; }
  @media (max-width: 700px) {
    .byos { text-align: left; }
    .agents { margin: 40px 0 28px; }
    li { padding: 4px 8px; text-align: center; }
    .agents { grid-template-columns: repeat(2, 1fr); row-gap: 24px; }
    /* Five cards in two columns: the last one sits centered on its own row. */
    li:last-child { grid-column: 1 / -1; }
    li img, .add-mark { width: 36px; height: 36px; }
    h3 { font-size: 15px; }
    li p { font-size: 12px; }
    .note { font-size: 13px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .add-mark { transition: none; }
    .add:hover .add-mark { transform: none; }
  }
</style>
