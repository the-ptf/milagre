---
import { DOWNLOAD_ANDROID, DOWNLOAD_ARM64, DOWNLOAD_LINUX_APPIMAGE, DOWNLOAD_LINUX_DEB, DOWNLOAD_LINUX_RPM, DOWNLOAD_WINDOWS, DOWNLOAD_X64, IPHONE_BETA_URL } from "../links";
// The main Linux button is the .deb or .rpm when the browser names a Debian- or Red Hat-family distribution
// (Base.astro sets data-linux from the user agent; Firefox on Ubuntu, Debian, Mint and Fedora does), and the AppImage,
// which runs anywhere, otherwise.
const LINUX: { id: string; href: string; others: [string, string][] }[] = [
  { id: "appimage", href: DOWNLOAD_LINUX_APPIMAGE, others: [[".deb", DOWNLOAD_LINUX_DEB], [".rpm", DOWNLOAD_LINUX_RPM]] },
  { id: "deb", href: DOWNLOAD_LINUX_DEB, others: [["AppImage", DOWNLOAD_LINUX_APPIMAGE], [".rpm", DOWNLOAD_LINUX_RPM]] },
  { id: "rpm", href: DOWNLOAD_LINUX_RPM, others: [["AppImage", DOWNLOAD_LINUX_APPIMAGE], [".deb", DOWNLOAD_LINUX_DEB]] },
];
---
<!-- Every set ships; Base.astro marks iPhones, iPads, Android, Windows and Linux before first paint, so each device sees its own. -->
<div class="downloads mac-only">
  <a class="button button-primary" href={DOWNLOAD_ARM64}>
    <svg aria-hidden="true" width="16" height="16"><use href="/icons.svg#apple" /></svg>
    Download for macOS
  </a>
  <p class="notes"><a href={DOWNLOAD_X64}>Intel Mac</a><span aria-hidden="true">·</span><a href={DOWNLOAD_LINUX_APPIMAGE}>Linux</a><span aria-hidden="true">·</span><a href={DOWNLOAD_WINDOWS}>Windows</a></p>
</div>
{
  LINUX.map((linux) => (
    <div class={`downloads linux-only linux-${linux.id}`}>
      <a class="button button-primary" href={linux.href}>
        <svg aria-hidden="true" width="18" height="18"><use href="/icons.svg#linux" /></svg>
        Download for Linux
      </a>
      <p class="notes">
        {linux.others.map(([label, href]) => (
          <>
            <a href={href}>{label}</a>
            <span aria-hidden="true">·</span>
          </>
        ))}
        <a href={DOWNLOAD_ARM64}>macOS</a>
        <span aria-hidden="true">·</span>
        <a href={DOWNLOAD_WINDOWS}>Windows</a>
      </p>
    </div>
  ))
}
<div class="downloads windows-only">
  <a class="button button-primary" href={DOWNLOAD_WINDOWS}>
    <svg aria-hidden="true" width="15" height="15"><use href="/icons.svg#windows" /></svg>
    Download for Windows
  </a>
  <p class="notes"><a href={DOWNLOAD_ARM64}>macOS</a><span aria-hidden="true">·</span><a href={DOWNLOAD_LINUX_APPIMAGE}>Linux</a></p>
</div>
<div class="downloads android-only">
  <a class="button button-primary" href={DOWNLOAD_ANDROID}>
    <svg aria-hidden="true" width="18" height="18"><use href="/icons.svg#android" /></svg>
    Download Android beta
  </a>
</div>
<div class="downloads ios-only">
  <a class="button button-primary" href={IPHONE_BETA_URL}>
    <svg aria-hidden="true" width="16" height="16"><use href="/icons.svg#apple" /></svg>
    Get iOS beta
  </a>
</div>

<style>
  .downloads { display: flex; flex-direction: column; align-items: center; gap: 10px; }
  /* Centred on the text's cap height rather than its line box, which sits a pixel low. */
  .button svg { flex: none; transform: translateY(-1px); }
  /* Quiet links under the main button for every other desktop build; phones get only their own beta. */
  .notes { display: flex; gap: 8px; margin: 0; color: var(--ink-3); font-size: 13px; }
  .notes a { color: var(--ink-2); text-decoration: none; }
  .notes a:hover { color: var(--ink); text-decoration: underline; }
  .ios-only, .android-only, .linux-only, .windows-only { display: none; }
  :global(html[data-platform="ios"]) .ios-only,
  :global(html[data-platform="android"]) .android-only,
  :global(html[data-platform="linux"]:not([data-linux])) .linux-appimage,
  :global(html[data-platform="linux"][data-linux="deb"]) .linux-deb,
  :global(html[data-platform="linux"][data-linux="rpm"]) .linux-rpm,
  :global(html[data-platform="windows"]) .windows-only { display: flex; }
  :global(html[data-platform]) .mac-only { display: none; }
</style>
