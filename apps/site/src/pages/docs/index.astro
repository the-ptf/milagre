---
import { ArrowRight02Icon, CommandLineIcon, LaptopPhoneSyncIcon, PaintBoardIcon } from "@hugeicons/core-free-icons";
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import { icon } from "../../hugeicon";
import { CLI_VERSION } from "../../cli-reference";

const description = "Milagre documentation: the desktop and phone app, the milagre CLI for running agents on a computer without the desktop, and the design system.";
---
<Base title="Docs | Milagre" description={description}>
  <Nav />
  <main class="container docs-home">
    <header>
      <h1>Milagre docs</h1>
      <p class="lede">Pick what you're setting up.</p>
    </header>

    <div class="choices">
      <div class="choice soon">
        <span class="choice-icon" set:html={icon(LaptopPhoneSyncIcon, 22)} />
        <h2 id="app-title">Milagre app <span class="badge">Coming soon</span></h2>
        <p>The desktop app and the phone app: Projects, Chats, Worktrees, approvals and pairing your phone.</p>
      </div>

      <a class="choice" href="/docs/cli">
        <span class="choice-icon" set:html={icon(CommandLineIcon, 22)} />
        <h2 id="cli-title">CLI <span class="version">{CLI_VERSION}</span></h2>
        <p>Run agents on a server without the desktop, pair devices from a terminal, script every Chat and connect MCP clients.</p>
        <code>npx milagre serve</code>
        <span class="go">Read the CLI docs <span set:html={icon(ArrowRight02Icon, 16)} /></span>
      </a>

      <a class="choice" href="/design">
        <span class="choice-icon" set:html={icon(PaintBoardIcon, 22)} />
        <h2 id="design-title">Design system</h2>
        <p>The colour, type, spacing, motion and component rules the desktop and phone apps follow, with live specimens.</p>
        <code>DESIGN.md</code>
        <span class="go">Read the design system <span set:html={icon(ArrowRight02Icon, 16)} /></span>
      </a>
    </div>
  </main>
</Base>

<style>
  .docs-home { max-width: 880px; padding-top: 56px; padding-bottom: 96px; }
  h1 { font-size: clamp(34px, 6vw, 48px); }
  .lede { margin-top: 12px; color: var(--ink-2); font-size: 18px; }
  .choices { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-top: 40px; }
  .choice { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; padding: 24px; border-radius: var(--radius-window); background: var(--canvas); box-shadow: var(--shadow-card); color: var(--ink); text-decoration: none; transition: background-color 120ms var(--ease-out-strong), transform 120ms var(--ease-out-strong); }
  a.choice:hover { background: var(--surface); }
  a.choice:active { transform: scale(0.99); }
  .choice-icon { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 10px; background: var(--accent-tint); color: var(--accent-ink); }
  h2 { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; font-size: 22px; }
  .choice p { color: var(--ink-2); line-height: 1.6; }
  .version { color: var(--ink-3); font: 500 14px var(--font-mono); letter-spacing: 0; }
  .badge { padding: 2px 8px; border-radius: 999px; background: var(--surface); box-shadow: var(--shadow-btn); color: var(--ink-2); font-size: 12px; font-weight: 600; letter-spacing: 0; }
  code { padding: 4px 8px; border-radius: 6px; background: var(--surface); font-size: 13.5px; }
  .go { display: inline-flex; align-items: center; gap: 6px; margin-top: auto; padding-top: 8px; color: var(--accent-ink); font-weight: 600; font-size: 15px; }
  .go :global(svg) { transition: transform 120ms var(--ease-out-strong); }
  a.choice:hover .go :global(svg) { transform: translateX(3px); }
  .soon .choice-icon { background: var(--surface); color: var(--ink-3); }
  .soon h2 { color: var(--ink-2); }
  @media (prefers-reduced-motion: reduce) { .choice, .go :global(svg) { transition: none; } }
</style>
