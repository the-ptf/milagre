{
  "name": "@milagre/daemon",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "milagre": "src/command.cjs"
  },
  "files": [
    "src",
    "!src/*.test.cjs",
    "!src/relay-test-kit.cjs",
    "!src/large-project-fixture.cjs"
  ],
  "type": "commonjs",
  "exports": {
    "./*": "./src/*.cjs",
    "./package.json": "./package.json",
    "./bootstrap": {
      "types": "./src/bootstrap.d.cts",
      "default": "./src/bootstrap.cjs"
    }
  },
  "scripts": {
    "start": "node src/cli.cjs",
    "test": "node --test src/*.test.cjs"
  },
  "dependencies": {
    "@milagre/core": "0.1.0",
    "@milagre/shared": "0.1.0",
    "qrcode": "^1.5.4",
    "tweetnacl": "1.0.3",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=24"
  },
  "cliVersion": "0.3.0"
}
