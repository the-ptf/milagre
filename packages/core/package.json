{
  "name": "@milagre/core",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "src/runtime.cjs",
  "exports": {
    ".": {
      "types": "./src/runtime.d.cts",
      "default": "./src/runtime.cjs"
    },
    "./*": "./src/*.cjs",
    "./editors": {
      "types": "./src/editors.d.cts",
      "default": "./src/editors.cjs"
    },
    "./keep-awake": {
      "types": "./src/keep-awake.d.cts",
      "default": "./src/keep-awake.cjs"
    },
    "./agents/environment": {
      "types": "./src/agents/environment.d.cts",
      "default": "./src/agents/environment.cjs"
    }
  },
  "scripts": {
    "test": "node --test src/*.test.cjs src/agents/*.test.cjs src/linear/*.test.cjs src/routines/*.test.cjs src/bots/*.test.cjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.288",
    "@milagre/shared": "0.1.0",
    "@resvg/resvg-wasm": "2.6.2",
    "agent-desktop": "1.0.2",
    "agent-device": "0.21.35",
    "jsonc-parser": "^3.3.1",
    "markdown-it": "^15.0.2",
    "node-pty": "1.1.0",
    "smol-toml": "^1.8.0",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "expo-device-hub": "0.18.0"
  },
  "engines": {
    "node": ">=24"
  }
}
