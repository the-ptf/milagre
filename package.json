{
  "name": "milagre-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "main": "apps/desktop/electron/main.cjs",
  "scripts": {
    "dev": "npm run dev --workspace milagre",
    "build": "node scripts/prepare-simulator-helper.cjs && node scripts/prepare-node-pty.cjs && npm run typecheck --workspace @milagre/shared && npm run build --workspace milagre",
    "start": "npm run start --workspace milagre",
    "typecheck": "npm run typecheck --workspace @milagre/shared && npm run typecheck --workspace milagre",
    "test": "node scripts/test.cjs",
    "test:unit": "node scripts/test.cjs --unit",
    "test:electron": "node scripts/test.cjs --electron",
    "build:site": "npm run build --workspace @milagre/site",
    "typecheck:site": "npm run typecheck --workspace @milagre/site",
    "test:site:worker": "npm run test --workspace @milagre/site",
    "test:site": "node scripts/test-site.cjs",
    "record:site-demo": "node scripts/site-demo/record.cjs",
    "og:site": "node scripts/site-og.cjs",
    "benchmark:chat-flow": "node scripts/benchmark-chat-flow.cjs",
    "benchmark:mobile-preview": "node scripts/benchmark-mobile-preview.cjs",
    "release:preview": "node scripts/plan-release.cjs preview",
    "package:mac": "npm run build && electron-builder --mac dmg zip --publish never",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "package:linux": "npm run build && electron-builder --linux AppImage deb rpm --x64 --publish never",
    "package:managers": "node scripts/generate-package-managers.cjs",
    "package:mac:local": "npm run package:mac -- --config.mac.identity=- --config.mac.notarize=false",
    "daemon": "node apps/daemon/src/cli.cjs",
    "cli": "node apps/daemon/src/command.cjs",
    "package:cli": "node scripts/package-cli.cjs",
    "mobile": "npm run start --workspace @milagre/mobile",
    "mobile:demo": "node scripts/mobile-demo.cjs",
    "review:demo": "node scripts/review-demo.cjs",
    "mobile:host": "node scripts/mobile-host.cjs",
    "mobile:cloudflare": "node scripts/mobile-cloudflare.cjs",
    "typecheck:relay": "npm run typecheck --workspace @milagre/relay",
    "typecheck:mobile": "npm run typecheck --workspace @milagre/mobile",
    "package:repositories": "node scripts/generate-linux-repository.cjs",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prepare": "node scripts/prepare-node-pty.cjs && node -e \"require('node:fs').existsSync('.git') && require('node:child_process').execSync('lefthook install', { stdio: 'inherit' })\"",
    "knip": "knip"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@hugeicons/core-free-icons": "4.3.5",
    "@resvg/resvg-wasm": "2.6.2",
    "babel-plugin-react-compiler": "1.0.0",
    "chrome-launcher": "^1.2.2",
    "electron": "^44.5.1",
    "electron-builder": "26.17.0",
    "esbuild": "0.28.2",
    "inter-font": "3.19.0",
    "knip": "6.39.0",
    "lefthook": "2.1.17",
    "lighthouse": "^12.8.2",
    "lockfile-lint": "5.0.1",
    "lucide-static": "1.56.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "qrcode-terminal": "^0.12.0",
    "subset-font": "2.9.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24"
  },
  "build": {
    "appId": "com.milagre.app",
    "productName": "Milagre",
    "asar": true,
    "afterPack": "scripts/package-cloudflared.cjs",
    "extraResources": [
      {
        "from": "licenses",
        "to": "licenses",
        "filter": [
          "*-OFL.txt"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/@milagre/core/src/bundled-skills/**/*",
      "node_modules/@milagre/core/src/assets/**/*",
      "node_modules/agent-device/**/*",
      "node_modules/agent-desktop/**/*",
      "node_modules/expo-device-hub/**/*",
      "node_modules/node-datachannel/**/*",
      "node_modules/node-pty/**/*",
      "node_modules/ws/**/*",
      "node_modules/mediabunny/**/*",
      "node_modules/@fastify/busboy/**/*",
      "node_modules/@resvg/resvg-wasm/**/*",
      "node_modules/@fugood/**/*"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "app/public/**/*",
      "package.json",
      "!**/node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "!**/node_modules/shiki/**",
      "!**/node_modules/@shikijs/**",
      "!**/node_modules/node-pty/{deps,src,third_party,scripts}/**",
      "!**/node_modules/node-pty/**/*.pdb",
      "!**/node_modules/@fugood/node-whisper-wasm/**",
      "!**/node_modules/@fugood/node-whisper-*-cuda/**",
      "!**/node_modules/@fugood/node-whisper-*-vulkan/**"
    ],
    "directories": {
      "output": "release",
      "app": "apps/desktop"
    },
    "mac": {
      "artifactName": "Milagre-${version}-${arch}.${ext}",
      "category": "public.app-category.developer-tools",
      "icon": "apps/desktop/app/public/logo-milagre-image.png",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "entitlements": "apps/desktop/build/entitlements.mac.plist",
      "entitlementsInherit": "apps/desktop/build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Milagre uses the microphone when you dictate a message. Your voice is turned into text on this computer."
      },
      "files": [
        "!**/node_modules/node-pty/prebuilds/win32-*/**",
        "!**/node_modules/agent-desktop/bin/agent-desktop-{linux,win32}-*"
      ],
      "notarize": true
    },
    "dmg": {
      "title": "Milagre"
    },
    "win": {
      "files": [
        "!**/node_modules/node-pty/prebuilds/darwin-*/**",
        "!**/node_modules/agent-desktop/bin/agent-desktop-{darwin,linux,macos}-*"
      ],
      "target": [
        "nsis"
      ],
      "artifactName": "Milagre-Setup-${version}-${arch}.${ext}",
      "icon": "apps/desktop/app/public/logo-milagre-image.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "artifactName": "Milagre-${version}-${arch}.${ext}",
      "executableName": "milagre",
      "files": [
        "!**/node_modules/node-pty/prebuilds/**"
      ],
      "category": "Development",
      "maintainer": "Milagre contributors",
      "icon": "apps/desktop/build/icons",
      "syncDesktopName": true
    },
    "publish": {
      "provider": "github",
      "owner": "the-ptf",
      "repo": "milagre-ade",
      "releaseType": "release"
    }
  },
  "productName": "Milagre"
}
