{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 160,
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": false,
  "semi": true,
  "trailingComma": "all",
  "ignorePatterns": [
    "**/dist/**",
    "**/release/**",
    "package-lock.json",
    "**/*.gen.ts",
    "apps/mobile/ios/**",
    "apps/mobile/android/**",
    ".expo/**",
    "**/.expo/**",
    "packages/core/src/bundled-skills/**",
    "packages/shared/src/design-font-data.mjs",
    "packages/shared/src/design-font-catalog.mjs",
    "packages/shared/src/design-catalog-fonts/**",
    "packages/shared/src/design-icons.mjs"
  ]
}
