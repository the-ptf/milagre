{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.cjs", "scripts/*.sh", "scripts/site-demo/*.cjs", "scripts/html-eval/*.cjs", "scripts/dictation-eval/run.mjs"],
      "project": ["scripts/**"],
      "ignoreDependencies": ["expo", "expo-router", "vite", "app-builder-lib", "builder-util", "expo-device-hub"],
      "ignore": ["scripts/fixtures/mobile-prompt-skills.tsx"]
    },
    "apps/desktop": {
      "entry": ["electron/preload.cjs", "app/index.html", "electron/*.test.cjs", "app/src/**/*.test.ts"],
      "project": ["app/src/**", "electron/**"],
      "ignoreDependencies": ["@tailwindcss/postcss", "postcss"]
    },
    "apps/daemon": {
      "entry": ["src/*.cjs"],
      "project": ["src/**"]
    },
    "apps/relay": {
      "entry": ["src/worker.ts", "src/*.test.mjs"],
      "project": ["src/**"]
    },
    "apps/mobile": {
      "entry": ["src/app/**/*.tsx", "src/*.test.ts", "fingerprint.config.cjs"],
      "project": ["src/**"]
    },
    "apps/site": {
      "entry": ["worker/worker.ts", "worker/*.test.mjs"],
      "project": ["src/**", "worker/**"],
      "ignore": ["worker/handler.d.mts"],
      "ignoreDependencies": ["cookie"]
    },
    "packages/core": {
      "entry": ["src/*.cjs", "src/agents/*.cjs"],
      "project": ["src/**"],
      "ignore": ["src/simulators.d.cts", "src/browsers.d.cts"],
      "ignoreDependencies": ["agent-device"]
    },
    "packages/shared": {
      "entry": ["src/*.ts", "src/*.mjs"],
      "project": ["src/**"]
    },
    "apps/design-share": {
      "entry": ["src/worker.ts", "src/*.test.mjs"],
      "project": ["src/**"]
    }
  },
  "ignoreDependencies": [],
  "ignoreBinaries": ["say", "afconvert", "swiftc"],
  "ignoreIssues": {
    "apps/mobile/src/update-sheet.tsx": ["exports"],
    "apps/mobile/src/accounts-section.tsx": ["exports"]
  }
}
